DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse
# Optional. Without it rate limits and live events are per process, and the worker's
# events don't reach the API's /api/stream.
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
# Lets monitors target localhost and private networks. Development only.
ALLOW_PRIVATE_TARGETS=0
# Optional: enables Telegram channels.
TELEGRAM_BOT_TOKEN=
